# Public demo credentials for Restful-Booker - published in its API docs, not real secrets.
# This assessment uses public demo credentials only.
# In production, dotenvx can encrypt secret values using `dotenvx encrypt`.
# Encrypted .env files can be committed to Git.
# Private decryption keys (.env.keys) must remain gitignored.
# CI/CD should obtain decryption keys from a secure secrets manager.

BOOKING_API_USERNAME=admin
BOOKING_API_PASSWORD=password123