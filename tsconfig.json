{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"noEmit": true,
		"types": ["node"]
	},
	"include": [
		"playwright.config.ts",
		"tests/**/*.ts",
		"support/**/*.ts",
		"pages/**/*.ts"
	]
}
