{
	"$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": {
		"includes": ["**/*.ts", "**/*.js", "**/*.json", "!**/node_modules"]
	},
	"linter": {
		"enabled": true,
		"domains": { "playwright": "all" },
		"rules": { "preset": "recommended" }
	}
}
